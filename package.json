{
  "name": "@imanueldev/eyeball",
  "version": "0.1.1",
  "description": "An open-source, framework-aware frontend QA agent that inspects rendered applications, tests interactions, captures visual evidence, and reports visual, accessibility, and functional issues.",
  "license": "Apache-2.0",
  "author": "De real iManuel",
  "type": "module",
  "bin": {
    "eyeballs": "bin/eyeball.js",
    "eyeball": "bin/eyeball.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SECURITY-REVIEW.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "audit": "node bin/eyeball.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.65.1"
  },
  "keywords": [
    "frontend",
    "quality-assurance",
    "visual-testing",
    "accessibility",
    "playwright",
    "cli",
    "testing",
    "web-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/De-real-iManuel/womm-eyeball.git"
  },
  "homepage": "https://github.com/De-real-iManuel/womm-eyeball#readme",
  "bugs": {
    "url": "https://github.com/De-real-iManuel/womm-eyeball/issues"
  }
}
